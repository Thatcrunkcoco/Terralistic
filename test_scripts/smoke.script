# smoke test: the validated harness action set, in a realistic order.
# Run: cargo run -- client --test --hidden --script test_scripts/smoke.script \
#        --capture /tmp/terralistic_smoke --capture-frames 10 --capture-interval 0
wait 500
chat /pos                       # chat round-trip (reply appears as a chat line)
wait 1200
shot
chat /setblock stone 36 179     # place a block in the open, right of spawn
wait 800
press 1 30                      # select hotbar slot 1 = pickaxe (stone needs it)
wait 300
worldclick 36 179 left 4000     # mine the placed stone (steering aligns itself)
wait 1200
shot
tp 256 150                      # client-side teleport (camera shifts down a bit)
wait 800
press d 1500                    # walk right briefly
shot
exit
